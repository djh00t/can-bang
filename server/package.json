    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "4.17.25",
    "@types/supertest": "6.0.3",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.10",
    "supertest": "7.2.2",
    "vitest": "4.1.10"
  }
}
